    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH inp AS (\n  SELECT $1::jsonb AS data\n),\nrows AS (\n  SELECT jsonb_array_elements(\n    CASE jsonb_typeof(data)\n      WHEN 'array'  THEN data\n      WHEN 'object' THEN jsonb_build_array(data) \n      ELSE '[]'::jsonb\n    END\n  ) AS elem\n  FROM inp\n),\nmapped AS (\n  SELECT\n    (elem->>'timestamp')::date AS \"timestamp\",\n    elem->>'słowo_pl'         AS \"słowo_pl\",\n    elem->>'słowo_ang'        AS \"słowo_ang\",\n    elem->>'przykład1_ang'    AS \"przykład1_ang\",\n    elem->>'przykład1_pl'     AS \"przykład1_pl\",\n    elem->>'przykład2_ang'    AS \"przykład2_ang\",\n    elem->>'przykład2_pl'     AS \"przykład2_pl\",\n    elem->>'przykład3_ang'    AS \"przykład3_ang\",\n    elem->>'przykład3_pl'     AS \"przykład3_pl\",\n    elem                      AS raw_json\n  FROM rows\n),\nins AS (\n  INSERT INTO public.word_of_day (\n    \"timestamp\",\"słowo_pl\",\"słowo_ang\",\n    \"przykład1_ang\",\"przykład1_pl\",\n    \"przykład2_ang\",\"przykład2_pl\",\n    \"przykład3_ang\",\"przykład3_pl\",\n    raw_json\n  )\n  SELECT\n    \"timestamp\",\"słowo_pl\",\"słowo_ang\",\n    \"przykład1_ang\",\"przykład1_pl\",\n    \"przykład2_ang\",\"przykład2_pl\",\n    \"przykład3_ang\",\"przykład3_pl\",\n    raw_json\n  FROM mapped\n  ON CONFLICT (\"słowo_ang\") DO NOTHING\n  RETURNING 1 AS inserted\n),\nresult AS (\n  -- jeśli coś się wstawiło, mamy inserted = true\n  SELECT TRUE AS inserted FROM ins\n  UNION ALL\n  -- jeśli nic się nie wstawiło, zwróć 1 wiersz z inserted = false\n  SELECT FALSE AS inserted\n  WHERE NOT EXISTS (SELECT 1 FROM ins)\n)\nSELECT inserted FROM result;",
        "options": {
          "queryReplacement": "={{ JSON.stringify($json) }}"
        }
      },
