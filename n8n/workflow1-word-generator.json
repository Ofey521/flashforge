    {
      "parameters": {
        "language": "python",
        "pythonCode": "import json\nresults = []\n\nfor item in items:\n    output_raw = item[\"json\"][\"output\"]\n    output = json.loads(output_raw)\n    first_item = output[\"items\"][0]\n\n    # wyciągamy pierwsze polskie słowo przed średnikiem\n    slowo_pl = first_item[\"słowo_pl\"].split(\";\")[0].strip()\n\n    # tworzymy nowy, prosty obiekt json\n    new_json = {\n        \"timestamp\": first_item[\"timestamp\"],\n        \"słowo_pl\": slowo_pl,\n        \"słowo_ang\": first_item[\"słowo_ang\"],\n        \"przykład1_ang\": first_item[\"przykład1_ang\"],\n        \"przykład1_pl\": first_item[\"przykład1_pl\"],\n        \"przykład2_ang\": first_item[\"przykład2_ang\"],\n        \"przykład2_pl\": first_item[\"przykład2_pl\"],\n        \"przykład3_ang\": first_item[\"przykład3_ang\"],\n        \"przykład3_pl\": first_item[\"przykład3_pl\"],\n    }\n\n    results.append({\"json\": new_json})\n\n# zwracamy listę elementów (tak jak oczekuje n8n)\nreturn results"
      },
